---
import { nl } from '../i18n/nl';
import { en } from '../i18n/en';

interface Props {
  locale: 'nl' | 'en';
}

const { locale } = Astro.props;
const t = locale === 'nl' ? nl : en;
const fc = t.home.featuredCases;
---

<section class="section section-alt" id="featured-cases">
  <div class="wrap">
    <div class="showcase-head">
      <span class="eyebrow">{fc.eyebrow}</span>
      <h2>{fc.title}</h2>
      <p class="lede">{fc.lede}</p>
    </div>

    <div class="showcase-grid">
      {fc.cases.map((c) => (
        <article class="case-card">
          <div class="case-card-media">
            <span class="case-id-badge">{c.id}</span>
            <img src={c.image} alt={c.title} loading="lazy" />
          </div>
          <div class="case-card-body">
            <div class="case-meta">
              <span class="case-tag">{c.tag}</span>
              <span class="case-status">{c.status}</span>
            </div>
            <h3>{c.title}</h3>
            <p>{c.summary}</p>
            <div class="case-actions">
              <a class="btn btn-primary case-btn" href={c.pageHref}>
                {c.ctaPage} &rarr;
              </a>
              <a class="btn btn-ghost case-btn-pitch" href={c.pitchHref} target={c.pitchHref.startsWith('http') ? '_blank' : undefined} rel={c.pitchHref.startsWith('http') ? 'noopener' : undefined}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 0.35rem;">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                {c.ctaPitch}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .showcase-head {
    max-width: 44rem;
    margin-bottom: 2.75rem;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.75rem;
  }

  .case-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .case-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(14, 26, 36, 0.12);
    border-color: var(--accent);
  }

  .case-card-media {
    position: relative;
    height: 190px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .case-card-media img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 240ms ease;
  }

  .case-card:hover .case-card-media img {
    transform: scale(1.04);
  }

  .case-id-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--dark);
    color: var(--on-dark);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.04em;
    z-index: 2;
  }

  .case-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .case-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    align-items: center;
  }

  .case-tag {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent-strong);
    background: var(--accent-soft);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .case-status {
    font-size: 0.75rem;
    font-weight: 500;
    color: #2e7d32;
    background: #e8f5e9;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .case-card h3 {
    margin: 0 0 0.6rem;
    font-size: 1.15rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .case-card p {
    margin: 0 0 1.4rem;
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--ink-soft);
    flex: 1;
  }

  .case-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .case-btn {
    padding: 0.45rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    flex: 1;
    text-align: center;
    justify-content: center;
  }

  .case-btn-pitch {
    padding: 0.45rem 0.75rem;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 680px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
