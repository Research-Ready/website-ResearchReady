---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: 'nl' | 'en';
  data: any;
  heroImage: string;
  heroImageAlt: string;
  pitchHref: string;
}

const { locale, data, heroImage, heroImageAlt, pitchHref } = Astro.props;
const contactHref = locale === 'nl' ? '/contact/' : '/en/contact/';
---

<BaseLayout locale={locale} title={data.title} description={data.description} image={heroImage}>

  <!-- Hero Section -->
  <section class="hero section-dark">
    <div class="wrap hero-wrap">
      <div class="hero-copy">
        <span class="eyebrow">{data.eyebrow}</span>
        <h1>{data.headline}</h1>
        <p class="lede">{data.lede}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={contactHref}>{data.cta.primary}</a>
          <a class="btn btn-ghost" href={pitchHref}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: .5rem; vertical-align: middle;">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            {data.pitch.buttonText}
          </a>
        </div>
      </div>
      <div class="hero-media">
        <div class="hero-card-frame">
          <img src={heroImage} alt={heroImageAlt} class="hero-image" />
        </div>
      </div>
    </div>
  </section>

  <!-- Vision & Mission Section -->
  <section class="section section-alt" id="visie-missie">
    <div class="wrap">
      <div class="vision-mission-grid">
        <div class="vm-card">
          <div class="vm-header">
            <span class="eyebrow">{locale === 'nl' ? 'Toekomstbeeld' : 'Future State'}</span>
            <h2>{data.vision.title}</h2>
          </div>
          <p class="vm-body">{data.vision.body}</p>
        </div>
        <div class="vm-card vm-card-accent">
          <div class="vm-header">
            <span class="eyebrow">{locale === 'nl' ? 'Realisatie' : 'Execution'}</span>
            <h2>{data.mission.title}</h2>
          </div>
          <p class="vm-body">{data.mission.body}</p>
          <ul class="vm-list">
            {data.mission.bullets.map((b: string) => (
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="section" id="probleem">
    <div class="wrap split">
      <div class="split-copy">
        <span class="eyebrow">{data.problem.eyebrow}</span>
        <h2>{data.problem.title}</h2>
        <p class="lede-problem">{data.problem.body}</p>
      </div>
      <div class="problem-cards">
        {data.problem.points.map((pt: string) => (
          <div class="problem-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#d9534f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="warn-icon">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <p>{pt}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Epics & Roadmap Section -->
  <section class="section section-alt" id="epics">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{data.epics.eyebrow}</span>
        <h2>{data.epics.title}</h2>
        <p class="section-intro">{data.epics.intro}</p>
      </div>
      <div class="epics-grid">
        {data.epics.items.map((epic: { id: string; title: string; status: string; statusLabel: string; body: string }) => (
          <div class={`epic-card status-${epic.status}`}>
            <div class="epic-top">
              <span class="epic-id">{epic.id}</span>
              <span class={`epic-status-badge badge-${epic.status}`}>{epic.statusLabel}</span>
            </div>
            <h3>{epic.title}</h3>
            <p>{epic.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Results & Artifacts Gallery -->
  <section class="section" id="resultaten">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{data.results.eyebrow}</span>
        <h2>{data.results.title}</h2>
        <p class="section-intro">{data.results.intro}</p>
      </div>
      <div class="results-grid">
        {data.results.items.map((res: { title: string; image: string; caption: string }) => (
          <figure class="result-card">
            <div class="result-img-wrap">
              <img src={res.image} alt={res.title} loading="lazy" />
            </div>
            <figcaption>
              <h4>{res.title}</h4>
              <p>{res.caption}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Pitch Presentation Banner -->
  <section class="section pitch-highlight-section">
    <div class="wrap">
      <div class="pitch-banner">
        <div class="pitch-banner-copy">
          <span class="eyebrow">{data.pitch.eyebrow}</span>
          <h2>{data.pitch.title}</h2>
          <p>{data.pitch.body}</p>
          <div class="pitch-banner-actions">
            <a class="btn btn-primary" href={pitchHref}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: .5rem; vertical-align: middle;">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              {data.pitch.buttonText}
            </a>
            {data.pitch.externalBookUrl && (
              <a class="btn btn-ghost" href={data.pitch.externalBookUrl} target="_blank" rel="noopener">
                {locale === 'nl' ? 'Open Live Quarto Boek ↗' : 'Open Live Quarto Book ↗'}
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section-dark">
    <div class="wrap cta-wrap">
      <h2>{data.cta.title}</h2>
      <p class="cta-lede">{data.cta.body}</p>
      <div class="hero-actions cta-actions">
        <a class="btn btn-primary" href={contactHref}>{data.cta.primary}</a>
        <a class="btn btn-ghost" href={pitchHref}>{data.cta.secondary}</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero-wrap {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-media {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .hero-card-frame {
    background: var(--surface);
    border-radius: var(--radius-md);
    padding: 0.75rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    border: 1px solid var(--on-dark-border);
    max-width: 100%;
    overflow: hidden;
  }
  .hero-image {
    width: 100%;
    height: auto;
    max-height: 380px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    display: block;
    background: #ffffff;
  }

  .vision-mission-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  .vm-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 2.2rem;
  }
  .vm-card-accent {
    border-top: 4px solid var(--accent);
  }
  .vm-header h2 {
    margin: 0.4rem 0 1rem;
    font-size: 1.45rem;
  }
  .vm-body {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--ink-soft);
    margin-bottom: 1.2rem;
  }
  .vm-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .vm-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.98rem;
    color: var(--ink-soft);
  }
  .check-icon {
    stroke: var(--accent);
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 3rem;
  }
  .lede-problem {
    font-size: 1.15rem;
    color: var(--ink-soft);
    line-height: 1.7;
  }
  .problem-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .problem-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1.1rem 1.4rem;
  }
  .problem-item p {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .warn-icon {
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .section-head {
    max-width: 44rem;
    margin-bottom: 2.5rem;
  }
  .section-intro {
    font-size: 1.15rem;
    color: var(--ink-soft);
    margin-top: 0.5rem;
  }

  .epics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .epic-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
  }
  .epic-card.status-done {
    border-top: 4px solid #2e7d32;
  }
  .epic-card.status-in_progress {
    border-top: 4px solid #ed6c02;
  }
  .epic-card.status-planned {
    border-top: 4px solid var(--accent);
  }
  .epic-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
  }
  .epic-id {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--muted);
  }
  .epic-status-badge {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }
  .badge-done {
    background: #e8f5e9;
    color: #1b5e20;
  }
  .badge-in_progress {
    background: #fff3e0;
    color: #e65100;
  }
  .badge-planned {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  .epic-card h3 {
    font-size: 1.15rem;
    margin: 0 0 0.6rem;
    color: var(--ink);
  }
  .epic-card p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 2rem;
  }
  .result-card {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .result-img-wrap {
    width: 100%;
    height: 320px;
    background: #fbfcfd;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .result-img-wrap img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }
  .result-card figcaption {
    padding: 1.25rem 1.5rem;
  }
  .result-card h4 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
    color: var(--ink);
  }
  .result-card p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .pitch-highlight-section {
    background: linear-gradient(135deg, #10212f 0%, #1a3347 100%);
    color: #ffffff;
  }
  .pitch-banner {
    padding: 3rem 1.5rem;
    text-align: center;
  }
  .pitch-banner-copy {
    max-width: 44rem;
    margin: 0 auto;
  }
  .pitch-banner-copy .eyebrow {
    color: #8cc4e2;
  }
  .pitch-banner-copy h2 {
    color: #ffffff;
    font-size: 2.1rem;
    margin: 0.5rem 0 1rem;
  }
  .pitch-banner-copy p {
    color: #d1e2ec;
    font-size: 1.15rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .pitch-banner-actions {
    display: flex;
    justify-content: center;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .cta-wrap {
    text-align: center;
    padding: 3.5rem 1.5rem;
  }
  .cta-wrap h2 {
    color: var(--on-dark);
    font-size: 2.1rem;
    margin-bottom: 0.8rem;
  }
  .cta-lede {
    color: var(--on-dark-muted);
    max-width: 40rem;
    margin: 0 auto 2.2rem;
    font-size: 1.15rem;
  }
  .cta-actions {
    justify-content: center;
  }

  @media (max-width: 860px) {
    .hero-wrap, .split, .vision-mission-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .hero-media {
      order: -1;
    }
  }
</style>
