---
import 'reveal.js/reveal.css';
import '../styles/pitch.css';

interface Props {
  locale: 'nl' | 'en';
  t: any;
}

const { locale, t } = Astro.props;
const contactHref = locale === 'nl' ? '/contact/' : '/en/contact/';
const homeHref = locale === 'nl' ? '/' : '/en/';
const firstFour = t.pipelines.items.slice(0, 4);
const lastFour = t.pipelines.items.slice(4, 8);
---

<a class="pitch-exit" href={homeHref}>&larr; research-ready.nl</a>

<div class="reveal-root">
  <div class="reveal">
    <div class="slides">
      <section>
        <span class="slide-eyebrow">{t.home.eyebrow}</span>
        <h1>{t.home.title}</h1>
        <p class="slide-lede">{t.home.tagline}</p>
        <svg class="slide-graphic" width="260" height="220" viewBox="0 0 320 280" role="img" aria-hidden="true">
          <g stroke="#25445a" stroke-width="2" fill="none">
            <path d="M50 50 L50 130" />
            <path d="M50 130 L160 130" />
            <path d="M160 130 L160 50" />
            <path d="M160 130 L160 210" />
            <path d="M160 210 L270 210" />
            <path d="M270 210 L270 130" />
          </g>
          <circle cx="50" cy="50" r="8" fill="#7fb8d6" />
          <circle cx="50" cy="130" r="8" fill="#2f6f92" />
          <circle cx="160" cy="50" r="7" fill="#3a4c58" />
          <circle cx="160" cy="130" r="10" fill="#2f6f92" />
          <circle cx="160" cy="210" r="7" fill="#3a4c58" />
          <circle cx="270" cy="210" r="8" fill="#2f6f92" />
          <circle cx="270" cy="130" r="8" fill="#7fb8d6" />
        </svg>
      </section>

      <section>
        <h2>{t.home.headline}</h2>
        <p class="slide-lede">{t.home.lede}</p>
        <div class="slide-stats">
          {t.home.stats.map((s: { num: string; label: string }) => (
            <div>
              <span class="slide-stat-num">{s.num}</span>
              <span class="slide-stat-label">{s.label}</span>
            </div>
          ))}
        </div>
      </section>

      <section>
        <span class="slide-eyebrow">{t.home.sovereign.eyebrow}</span>
        <h2>{t.home.sovereign.title}</h2>
        <p>{t.home.sovereign.body}</p>
        <ul class="slide-checklist">
          {t.home.sovereign.points.map((point: string) => <li>{point}</li>)}
        </ul>
      </section>

      <section>
        <span class="slide-eyebrow">{t.pipelines.title}</span>
        <h2>{t.home.pipelinesTeaser.title}</h2>
        <p class="slide-lede" style="font-size: 0.7em;">{t.home.pipelinesTeaser.intro}</p>
        <div class="slide-pipeline-grid">
          {firstFour.map((item: { title: string; repo: string; description: string }, i: number) => (
            <div class="slide-pipeline-card">
              <span class="slide-pipeline-index">{String(i + 1).padStart(2, '0')}</span>
              <h3>{item.title} <span class="slide-repo-badge">{item.repo}</span></h3>
              <p>{item.description}</p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <span class="slide-eyebrow">{t.pipelines.title}</span>
        <h2>{t.home.pipelinesTeaser.title}</h2>
        <div class="slide-pipeline-grid">
          {lastFour.map((item: { title: string; repo: string; description: string }, i: number) => (
            <div class="slide-pipeline-card">
              <span class="slide-pipeline-index">{String(i + 5).padStart(2, '0')}</span>
              <h3>{item.title} <span class="slide-repo-badge">{item.repo}</span></h3>
              <p>{item.description}</p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <span class="slide-eyebrow">{t.contact.title}</span>
        <h2>{t.home.closingCta.title}</h2>
        <p class="slide-lede">{t.home.closingCta.body}</p>
        <div class="slide-actions">
          <a class="slide-btn slide-btn-primary" href={contactHref}>{t.home.closingCta.primary}</a>
          <a class="slide-btn slide-btn-ghost" href="mailto:info@research-ready.nl">{t.home.closingCta.secondary}</a>
        </div>
        <ul class="slide-contact-list">
          <li>research-ready.nl</li>
          <li><a href="mailto:info@research-ready.nl">info@research-ready.nl</a></li>
          <li><a href="https://github.com/Research-Ready" target="_blank" rel="noopener">{t.footer.githubLabel}</a></li>
        </ul>
      </section>
    </div>
  </div>
</div>

<script>
  import Reveal from 'reveal.js';

  const deck = new Reveal(document.querySelector('.reveal') as HTMLElement, {
    hash: true,
    controls: true,
    progress: true,
    center: false,
    transition: 'slide',
    width: 1280,
    height: 720,
  });
  deck.initialize();
</script>
