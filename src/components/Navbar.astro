---
import { nl } from '../i18n/nl';
import { en } from '../i18n/en';

interface Props {
  locale: 'nl' | 'en';
}

const { locale } = Astro.props;
const t = locale === 'nl' ? nl : en;

// Strip a leading /en to get the path's "shape", then rebuild for each locale.
const path = Astro.url.pathname.replace(/^\/en(\/|$)/, '/');
const nlHref = path;
const enHref = path === '/' ? '/en/' : `/en${path}`;
const toggleHref = locale === 'nl' ? enHref : nlHref;

const isActive = (shape: string) => path === shape || path.startsWith(shape);
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href={locale === 'nl' ? '/' : '/en/'}>
      <svg class="brand-mark" width="26" height="26" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M8 22 L16 10 L24 22" stroke="#2f6f92" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="16" cy="10" r="3" fill="#2f6f92" />
        <circle cx="8" cy="22" r="3" fill="#101c26" />
        <circle cx="24" cy="22" r="3" fill="#101c26" />
      </svg>
      Research-Ready
    </a>
    <div class="site-nav-row">
      <nav class="nav-links" aria-label="Main">
        <a href={locale === 'nl' ? '/' : '/en/'} aria-current={path === '/' ? 'page' : undefined}>{t.nav.home}</a>
        <a href={locale === 'nl' ? '/pipelines/' : '/en/pipelines/'} aria-current={path.startsWith('/pipelines') ? 'page' : undefined}>{t.nav.pipelines}</a>
        <a href={locale === 'nl' ? '/uc1-citable-research/' : '/en/uc1-citable-research/'} aria-current={path.startsWith('/uc1') ? 'page' : undefined} title="UC1: Citeerbaar Onderzoek">UC1</a>
        <a href={locale === 'nl' ? '/uc4-supplylens/' : '/en/uc4-supplylens/'} aria-current={path.startsWith('/uc4') ? 'page' : undefined} title="UC4: SupplyLens">UC4</a>
        <a href={locale === 'nl' ? '/container-collision/' : '/en/container-collision/'} aria-current={path.startsWith('/container-collision') ? 'page' : undefined} title="UC11: Container Collision">UC11</a>
        <a href={locale === 'nl' ? '/uc12-chainforge/' : '/en/uc12-chainforge/'} aria-current={path.startsWith('/uc12') ? 'page' : undefined} title="UC12: ChainForge AI Evaluatie">UC12</a>
        <a href={locale === 'nl' ? '/docs/' : '/en/docs/'} aria-current={path.startsWith('/docs') ? 'page' : undefined}>{t.nav.docs}</a>
        <a href={locale === 'nl' ? '/contact/' : '/en/contact/'} aria-current={path.startsWith('/contact') ? 'page' : undefined}>{t.nav.contact}</a>
        <a class="btn btn-ghost nav-pitch-btn" href={locale === 'nl' ? '/pitch/' : '/en/pitch/'} aria-current={path.startsWith('/pitch') ? 'page' : undefined}>{t.nav.pitch}</a>
      </nav>
      <a class="lang-toggle" href={toggleHref} aria-label="Switch language">{t.nav.langToggle}</a>
    </div>
  </div>
</header>
