---
import EdrmModal from './EdrmModal.astro';

interface Props {
  locale: 'nl' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';

const trustItems = isEn ? [
  {
    badge: 'Industry Partner',
    title: 'Scania AB',
    desc: 'Ground truth validation for supply chain graphs (UC4)',
    interactive: false,
  },
  {
    badge: 'Research Base',
    title: 'Topsector Logistics',
    desc: 'Empirical hinterland logistics research (SmartPort / Rebel)',
    interactive: false,
  },
  {
    badge: 'Evidentiary Standard',
    title: 'EDRM Discipline',
    desc: 'Forensically verifiable chain-of-custody for data and models',
    interactive: true,
  },
  {
    badge: 'Data Sovereignty',
    title: '100% EU Sovereign',
    desc: 'On-premise / private infrastructure with zero external data leakage',
    interactive: true,
  },
] : [
  {
    badge: 'Industriepartner',
    title: 'Scania AB',
    desc: 'Grondwaarheid validatie voor toeleveringsketens (UC4)',
    interactive: false,
  },
  {
    badge: 'Onderzoeksbasis',
    title: 'Topsector Logistiek',
    desc: 'Empirische data achterlandketens (SmartPort / Rebel 2026)',
    interactive: false,
  },
  {
    badge: 'Bewijsstandaard',
    title: 'EDRM Discipline',
    desc: 'Forensisch navolgbare chain-of-custody voor data en modellen',
    interactive: true,
  },
  {
    badge: 'Data-integriteit',
    title: '100% EU Soeverein',
    desc: 'On-premise / private cloud zonder doorgifte naar derden',
    interactive: true,
  },
];
---

<section class="trust-bar-section">
  <div class="wrap">
    <div class="trust-grid">
      {trustItems.map((item) => (
        <div class="trust-item">
          <span class="trust-badge">{item.badge}</span>
          <h4>
            {item.title}
            {item.interactive && (
              <button
                type="button"
                class="edrm-info-trigger"
                data-open-edrm-modal
                title={isEn ? "Click to learn more about EDRM & Sovereignty" : "Klik voor toelichting over EDRM & Soevereiniteit"}
                aria-label={isEn ? `Learn more about ${item.title}` : `Meer informatie over ${item.title}`}
              >
                ⓘ
              </button>
            )}
          </h4>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<EdrmModal locale={locale} />

<style>
  .trust-bar-section {
    background: #0b151d;
    border-top: 1px solid var(--on-dark-border);
    border-bottom: 1px solid var(--on-dark-border);
    padding: 1.75rem 0;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    align-items: center;
  }

  .trust-item {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
  }

  .trust-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #8cc4e2;
    display: block;
    margin-bottom: 0.2rem;
  }

  .trust-item h4 {
    margin: 0 0 0.2rem;
    font-size: 1rem;
    color: var(--on-dark);
    font-family: var(--font-display);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .edrm-info-trigger {
    background: transparent;
    border: 1px solid #2a455a;
    color: #8cc4e2;
    border-radius: 50%;
    width: 1.25rem;
    height: 1.25rem;
    font-size: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    line-height: 1;
    padding: 0;
    transition: all 140ms ease;
  }

  .edrm-info-trigger:hover {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .trust-item p {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--on-dark-muted);
  }

  @media (max-width: 600px) {
    .trust-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
