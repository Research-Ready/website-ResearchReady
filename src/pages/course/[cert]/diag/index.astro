---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { coursesBySlug, courseSlugs } from '../../../../data/courses/index';

export function getStaticPaths() {
  return courseSlugs.map(cert => ({ params: { cert } }));
}

const { cert } = Astro.params;
const course = coursesBySlug[cert!]!;

const accent: Record<string, string> = {
  'itil4': '#7b68ee',
  'sec-plus': '#e85d26',
};
const color = accent[cert!] ?? '#2f6f92';

const diagQuestions = course.modules.flatMap(mod => {
  const allKCs = mod.chapters.flatMap(ch => ch.knowledgeChecks);
  const mid = Math.floor(allKCs.length / 2);
  return [allKCs[0], allKCs[mid]].filter(Boolean).map(kc => ({
    ...kc,
    moduleTitle: mod.title,
    moduleId: mod.id,
  }));
});
---

<BaseLayout locale="en" title={`Diagnostic Quiz — ${course.title}`} description={`Short diagnostic quiz for ${course.title}. Find your weak areas before studying.`}>
  <section class="section">
    <div class="wrap" style={`--accent-color: ${color}`}>

      <!-- INTRO SCREEN -->
      <div id="screen-intro" class="screen">
        <a class="back-link" href={`/course/${cert}/`}>← Back to course</a>
        <div class="intro-card">
          <div class="intro-badge">{course.examCode}</div>
          <h1>Diagnostic Quiz</h1>
          <p class="intro-sub">{diagQuestions.length} questions &middot; 2 per module &middot; Immediate feedback</p>
          <p class="intro-desc">Find your weak areas before you start studying. Answer each question to see the correct answer and explanation right away.</p>
          <button class="start-btn" id="btn-start">Start diagnostic →</button>
        </div>
      </div>

      <!-- QUIZ SCREEN -->
      <div id="screen-quiz" class="screen hidden">
        <div class="quiz-progress">
          <span id="quiz-progress-label">Question 1 / {diagQuestions.length}</span>
          <div class="progress-bar"><div class="progress-fill" id="quiz-progress-fill" style="width:0%"></div></div>
        </div>

        <div class="question-card">
          <div class="module-pill" id="module-pill"></div>
          <p class="question-text" id="question-text"></p>
          <div class="options-list" id="options-list"></div>
          <div id="feedback-block" class="feedback-block hidden"></div>
        </div>

        <div class="quiz-controls">
          <button class="next-btn hidden" id="btn-next">Next →</button>
        </div>
      </div>

      <!-- RESULT SCREEN -->
      <div id="screen-result" class="screen hidden">
        <a class="back-link" href={`/course/${cert}/`}>← Back to course</a>
        <div class="result-card">
          <h1 class="result-heading" id="result-heading"></h1>
          <p class="result-sub" id="result-sub"></p>

          <h2 class="breakdown-heading">Module breakdown</h2>
          <div id="module-breakdown" class="module-breakdown"></div>

          <div class="result-actions">
            <button class="start-btn" id="btn-retake">Retake diagnostic</button>
            <a class="back-link-btn" href={`/course/${cert}/`}>Go to course overview</a>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<script define:vars={{ cert, diagQuestions, passScore: course.passScore }}>
  let questions = [];
  let answers = [];
  let currentIdx = 0;

  function showScreen(id) {
    ['screen-intro', 'screen-quiz', 'screen-result'].forEach(s => {
      document.getElementById(s)?.classList.toggle('hidden', s !== id);
    });
  }

  function startQuiz() {
    questions = diagQuestions;
    answers = new Array(questions.length).fill(null);
    currentIdx = 0;
    showScreen('screen-quiz');
    renderQuestion();
  }

  function renderQuestion() {
    const q = questions[currentIdx];
    const total = questions.length;

    const pillEl = document.getElementById('module-pill');
    if (pillEl) pillEl.textContent = q.moduleTitle;

    const textEl = document.getElementById('question-text');
    if (textEl) textEl.textContent = q.question;

    const progressEl = document.getElementById('quiz-progress-fill');
    if (progressEl) progressEl.style.width = `${Math.round((currentIdx / total) * 100)}%`;

    const labelEl = document.getElementById('quiz-progress-label');
    if (labelEl) labelEl.textContent = `Question ${currentIdx + 1} / ${total}`;

    const feedbackEl = document.getElementById('feedback-block');
    if (feedbackEl) feedbackEl.classList.add('hidden');

    const nextBtn = document.getElementById('btn-next');
    if (nextBtn) nextBtn.classList.add('hidden');

    const optionsEl = document.getElementById('options-list');
    if (!optionsEl) return;
    optionsEl.innerHTML = '';

    const labels = ['A', 'B', 'C', 'D'];
    q.options.forEach((opt, i) => {
      const btn = document.createElement('button');
      btn.className = 'option-btn';
      btn.innerHTML = `<span class="opt-label">${labels[i]}</span><span class="opt-text">${opt}</span>`;
      btn.addEventListener('click', () => answerQuestion(i));
      optionsEl.appendChild(btn);
    });
  }

  function answerQuestion(chosenIdx) {
    const q = questions[currentIdx];
    answers[currentIdx] = chosenIdx;

    const optionBtns = document.querySelectorAll('.option-btn');
    optionBtns.forEach((btn, i) => {
      btn.disabled = true;
      if (i === q.correct) btn.classList.add('correct');
      else if (i === chosenIdx) btn.classList.add('wrong');
    });

    const feedbackEl = document.getElementById('feedback-block');
    if (feedbackEl) {
      const isCorrect = chosenIdx === q.correct;
      feedbackEl.className = 'feedback-block ' + (isCorrect ? 'feedback-correct' : 'feedback-wrong');
      feedbackEl.innerHTML = `<strong>${isCorrect ? 'Correct!' : 'Incorrect.'}</strong> ${q.explanation}`;
    }

    const nextBtn = document.getElementById('btn-next');
    if (nextBtn) {
      nextBtn.classList.remove('hidden');
      const isLast = currentIdx === questions.length - 1;
      nextBtn.textContent = isLast ? 'See results →' : 'Next →';
    }
  }

  function renderResult() {
    const correct = answers.filter((a, i) => a === questions[i].correct).length;
    const total = questions.length;
    const headingEl = document.getElementById('result-heading');
    if (headingEl) headingEl.textContent = `${correct} / ${total} correct`;

    const subEl = document.getElementById('result-sub');
    if (subEl) subEl.textContent = `${Math.round((correct / total) * 100)}% overall`;

    const moduleMap = {};
    questions.forEach((q, i) => {
      if (!moduleMap[q.moduleId]) {
        moduleMap[q.moduleId] = { title: q.moduleTitle, moduleId: q.moduleId, correct: 0, total: 0 };
      }
      moduleMap[q.moduleId].total++;
      if (answers[i] === q.correct) moduleMap[q.moduleId].correct++;
    });

    const sorted = Object.values(moduleMap).sort((a, b) => {
      const pA = a.total ? a.correct / a.total : 0;
      const pB = b.total ? b.correct / b.total : 0;
      return pA - pB;
    });

    const breakdownEl = document.getElementById('module-breakdown');
    if (!breakdownEl) return;
    breakdownEl.innerHTML = sorted.map(mod => {
      const pct = mod.total ? Math.round((mod.correct / mod.total) * 100) : 0;
      const label = pct >= 80 ? 'Strong' : pct >= 50 ? 'OK' : 'Needs Work';
      const cls = pct >= 80 ? 'strength-strong' : pct >= 50 ? 'strength-ok' : 'strength-weak';
      return `
        <div class="mod-row">
          <div class="mod-info">
            <span class="mod-title">${mod.title}</span>
            <span class="mod-score">${mod.correct}/${mod.total}</span>
            <span class="strength-pill ${cls}">${label}</span>
          </div>
          ${pct < 80 ? `<a class="study-link" href="/course/${cert}/${mod.moduleId}/">Study now →</a>` : ''}
        </div>
      `;
    }).join('');
  }

  document.getElementById('btn-start')?.addEventListener('click', startQuiz);
  document.getElementById('btn-retake')?.addEventListener('click', () => showScreen('screen-intro'));
  document.getElementById('btn-next')?.addEventListener('click', () => {
    if (currentIdx < questions.length - 1) {
      currentIdx++;
      renderQuestion();
    } else {
      renderResult();
      showScreen('screen-result');
    }
  });
</script>

<style>
  .wrap { --accent-color: #2f6f92; }
  .screen.hidden { display: none; }

  .back-link { font-size: 0.875rem; color: var(--accent-color); text-decoration: none; display: inline-block; margin-bottom: 1.5rem; }
  .back-link:hover { text-decoration: underline; }

  /* Intro */
  .intro-card { background: #fff; border: 1px solid #d1d9e0; border-radius: 12px; padding: 2.5rem; max-width: 560px; margin: 0 auto; }
  .intro-badge { display: inline-block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; background: #e8eef3; color: #4a6478; padding: 0.2rem 0.6rem; border-radius: 4px; margin-bottom: 0.75rem; font-family: monospace; }
  .intro-card h1 { margin: 0 0 0.4rem; font-size: 1.75rem; }
  .intro-sub { color: #6a8499; font-size: 0.875rem; margin: 0 0 0.75rem; }
  .intro-desc { color: #374151; font-size: 0.9rem; margin: 0 0 1.75rem; line-height: 1.6; }
  .start-btn { display: inline-block; padding: 0.75rem 2rem; background: var(--accent-color); color: #fff; border: none; border-radius: 8px; font-size: 1rem; font-weight: 700; cursor: pointer; }
  .start-btn:hover { opacity: 0.9; }

  /* Quiz progress */
  .quiz-progress { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1rem; }
  .quiz-progress span { font-size: 0.8rem; color: #6a8499; }
  .progress-bar { height: 4px; background: #d1d9e0; border-radius: 2px; }
  .progress-fill { height: 100%; background: var(--accent-color); border-radius: 2px; transition: width 0.3s ease; }

  /* Question card */
  .question-card { background: #fff; border: 1px solid #d1d9e0; border-radius: 10px; padding: 1.75rem; margin-bottom: 1rem; }
  .module-pill { display: inline-block; font-size: 0.75rem; font-weight: 700; background: var(--accent-color); color: #fff; padding: 0.2rem 0.65rem; border-radius: 20px; margin-bottom: 1rem; opacity: 0.9; }
  .question-text { font-size: 1.05rem; font-weight: 600; color: #0e1a24; margin: 0 0 1.25rem; line-height: 1.5; }
  .options-list { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1rem; }
  .option-btn { display: flex; align-items: flex-start; gap: 0.75rem; width: 100%; text-align: left; padding: 0.75rem 1rem; border: 2px solid #d1d9e0; border-radius: 8px; background: #fff; cursor: pointer; font-size: 0.9rem; color: #374151; transition: border-color 0.15s; }
  .option-btn:hover:not(:disabled) { border-color: var(--accent-color); background: #f5f3ff; }
  .option-btn:disabled { cursor: default; }
  .option-btn.correct { border-color: #16a34a; background: #dcfce7; color: #14532d; }
  .option-btn.wrong { border-color: #dc2626; background: #fee2e2; color: #7f1d1d; }
  .opt-label { flex-shrink: 0; font-weight: 700; color: var(--accent-color); min-width: 1.2rem; }
  .option-btn.correct .opt-label { color: #16a34a; }
  .option-btn.wrong .opt-label { color: #dc2626; }

  .feedback-block { padding: 0.9rem 1.1rem; border-radius: 8px; font-size: 0.875rem; line-height: 1.6; }
  .feedback-block.hidden { display: none; }
  .feedback-correct { background: #dcfce7; border-left: 3px solid #16a34a; color: #14532d; }
  .feedback-wrong { background: #fee2e2; border-left: 3px solid #dc2626; color: #7f1d1d; }

  /* Controls */
  .quiz-controls { display: flex; justify-content: flex-end; }
  .next-btn { padding: 0.65rem 1.5rem; background: var(--accent-color); color: #fff; border: none; border-radius: 8px; font-size: 0.9rem; font-weight: 700; cursor: pointer; }
  .next-btn.hidden { display: none; }
  .next-btn:hover { opacity: 0.9; }

  /* Result */
  .result-card { background: #fff; border: 1px solid #d1d9e0; border-radius: 12px; padding: 2.5rem; max-width: 680px; margin: 0 auto; }
  .result-heading { font-size: 2.5rem; font-weight: 900; margin: 0 0 0.25rem; }
  .result-sub { color: #6a8499; margin: 0 0 2rem; }
  .breakdown-heading { font-size: 0.875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #4a6478; margin: 0 0 0.75rem; }
  .module-breakdown { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 2rem; }
  .mod-row { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.75rem 1rem; border: 1px solid #e5e7eb; border-radius: 8px; flex-wrap: wrap; }
  .mod-info { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; flex: 1; }
  .mod-title { font-weight: 600; color: #0e1a24; font-size: 0.9rem; }
  .mod-score { font-size: 0.8rem; color: #6a8499; }
  .strength-pill { font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 20px; }
  .strength-strong { background: #dcfce7; color: #15803d; }
  .strength-ok { background: #fef3c7; color: #b45309; }
  .strength-weak { background: #fee2e2; color: #b91c1c; }
  .study-link { font-size: 0.8rem; font-weight: 600; color: var(--accent-color); text-decoration: none; white-space: nowrap; }
  .study-link:hover { text-decoration: underline; }
  .result-actions { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .back-link-btn { padding: 0.75rem 1.5rem; border: 1px solid #d1d9e0; border-radius: 8px; font-size: 0.9rem; color: #374151; text-decoration: none; }
  .back-link-btn:hover { background: #f0f5f9; }
</style>
