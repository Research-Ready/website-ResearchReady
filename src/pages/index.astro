---
import BaseLayout from '../layouts/BaseLayout.astro';
import { nl } from '../i18n/nl';

const t = nl;
---

<BaseLayout locale="nl" title={t.home.title} description={t.home.tagline}>
  <h1>{t.home.title}</h1>
  <p>{t.home.tagline}</p>
  <p>{t.home.mission}</p>
  <p><a href="/pipelines/">{t.home.cta} →</a></p>
</BaseLayout>
