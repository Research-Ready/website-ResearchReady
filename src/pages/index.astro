---
import BaseLayout from '../layouts/BaseLayout.astro';
import { nl } from '../i18n/nl';

const t = nl;
const teaserItems = t.pipelines.items.slice(0, 4);
---

<BaseLayout locale="nl" title={t.home.title} description={t.home.tagline}>
  <section class="hero section-dark">
    <div class="wrap">
      <div class="hero-copy">
        <span class="eyebrow">{t.home.eyebrow}</span>
        <h1>{t.home.headline}</h1>
        <p class="lede">{t.home.lede}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/pipelines/">{t.home.ctaPrimary}</a>
          <a class="btn btn-ghost" href="/contact/">{t.home.ctaSecondary}</a>
        </div>
      </div>
      <svg class="hero-graphic" width="320" height="280" viewBox="0 0 320 280" role="img" aria-label="Schematische weergave van een AI-pipeline met meerdere verbonden stappen">
        <g stroke="#25445a" stroke-width="2" fill="none">
          <path d="M50 50 L50 130" />
          <path d="M50 130 L160 130" />
          <path d="M160 130 L160 50" />
          <path d="M160 130 L160 210" />
          <path d="M160 210 L270 210" />
          <path d="M270 210 L270 130" />
        </g>
        <circle cx="50" cy="50" r="8" fill="#7fb8d6" />
        <circle cx="50" cy="130" r="8" fill="#2f6f92" />
        <circle cx="160" cy="50" r="7" fill="#3a4c58" />
        <circle cx="160" cy="130" r="10" fill="#2f6f92" />
        <circle cx="160" cy="210" r="7" fill="#3a4c58" />
        <circle cx="270" cy="210" r="8" fill="#2f6f92" />
        <circle cx="270" cy="130" r="8" fill="#7fb8d6" />
      </svg>
      <div class="stat-strip" style="grid-column: 1 / -1;">
        {t.home.stats.map((s) => (
          <div class="stat">
            <span class="stat-num">{s.num}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split-copy">
        <span class="eyebrow">{t.home.sovereign.eyebrow}</span>
        <h2>{t.home.sovereign.title}</h2>
        <p>{t.home.sovereign.body}</p>
      </div>
      <ul class="check-list">
        {t.home.sovereign.points.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2>{t.home.pipelinesTeaser.title}</h2>
      <p class="lede">{t.home.pipelinesTeaser.intro}</p>
      <div class="teaser-grid">
        {teaserItems.map((item, i) => (
          <div class="teaser-card">
            <span class="teaser-index">{String(i + 1).padStart(2, '0')} · {item.repo}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
      <p style="margin-top: 2rem;"><a href="/pipelines/">{t.home.pipelinesTeaser.cta} →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">{t.home.approach.eyebrow}</span>
      <h2>{t.home.approach.title}</h2>
      <p class="lede">{t.home.approach.intro}</p>
      <div class="teaser-grid">
        {t.home.approach.steps.map((step, i) => (
          <div class="teaser-card">
            <span class="teaser-index">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>
      <p class="lede" style="margin-top: 2rem; font-size: 1.05rem;">{t.home.approach.closing}</p>
      <p style="margin-top: 0.75rem;"><a href={t.home.approach.link.href}>{t.home.approach.link.label} →</a></p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap split">
      <div class="split-copy">
        <span class="eyebrow">{t.home.gettingStarted.eyebrow}</span>
        <h2>{t.home.gettingStarted.title}</h2>
        <p>{t.home.gettingStarted.body}</p>
        <ul class="check-list">
          {t.home.gettingStarted.points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3>{t.home.gettingStarted.pilot.title}</h3>
        <ol style="list-style:none; margin:1.25rem 0 0; padding:0; display:grid; gap:1rem;">
          {t.home.gettingStarted.pilot.phases.map((phase) => (
            <li style="display:flex; gap:1rem; align-items:baseline;">
              <span class="repo-badge" style="flex-shrink:0;">{phase.range}</span>
              <span><strong>{phase.label}.</strong> {phase.body}</span>
            </li>
          ))}
        </ol>
        <p class="lede" style="margin-top:1.25rem; font-size:0.95rem;">{t.home.gettingStarted.pilot.asks.join(' · ')}</p>
        <p style="color: var(--muted); font-size:0.9rem;">{t.home.gettingStarted.pilot.note}</p>
      </div>
    </div>
  </section>

  <section class="section section-dark cta-band">
    <div class="wrap">
      <h2>{t.home.closingCta.title}</h2>
      <p class="lede">{t.home.closingCta.body}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/contact/">{t.home.closingCta.primary}</a>
        <a class="btn btn-ghost" href="mailto:info@research-ready.nl">{t.home.closingCta.secondary}</a>
      </div>
    </div>
  </section>
</BaseLayout>
