---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PipelineCatalog from '../../components/PipelineCatalog.astro';
import { en } from '../../i18n/en';

const t = en;
---

<BaseLayout locale="en" title={t.pipelines.title} description={t.pipelines.intro}>
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Directory & Portfolio</span>
      <h1>{t.pipelines.title}</h1>
      <p class="lede">{t.pipelines.intro}</p>
      <PipelineCatalog locale="en" />
    </div>
  </section>
</BaseLayout>
