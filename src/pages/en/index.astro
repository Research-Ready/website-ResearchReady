---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { en } from '../../i18n/en';

const t = en;
---

<BaseLayout locale="en" title={t.home.title} description={t.home.tagline}>
  <h1>{t.home.title}</h1>
  <p>{t.home.tagline}</p>
  <p>{t.home.mission}</p>
  <p><a href="/en/pipelines/">{t.home.cta} →</a></p>
</BaseLayout>
