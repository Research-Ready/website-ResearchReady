---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { en } from '../../i18n/en';

const t = en.containerCollision;
---

<BaseLayout locale="en" title={t.title} description={t.description}>

  <section class="hero section-dark">
    <div class="wrap">
      <div class="hero-copy">
        <span class="eyebrow">{t.eyebrow}</span>
        <h1>{t.headline}</h1>
        <p class="lede">{t.lede}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#learning-outcomes">{t.ctaLearn}</a>
          <a class="btn btn-ghost" href="/en/contact/">{t.ctaContact}</a>
        </div>
      </div>
      <div class="hero-game-graphic">
        <img src="/container-cascade/31026.jpg" alt="Container Cascade in play: players moving containers across the board, orange score tokens visible" class="hero-photo" />
      </div>
    </div>
  </section>

  <section class="section" id="for-whom">
    <div class="wrap split">
      <div class="split-copy">
        <span class="eyebrow">{t.audience.eyebrow}</span>
        <h2>{t.audience.title}</h2>
        <p>{t.audience.body}</p>
      </div>
      <ul class="check-list">
        {t.audience.points.map((p: string) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section-alt" id="learning-outcomes">
    <div class="wrap">
      <span class="eyebrow">{t.outcomes.eyebrow}</span>
      <h2>{t.outcomes.title}</h2>
      <p class="section-intro">{t.outcomes.intro}</p>
      <div class="card-grid">
        {t.outcomes.items.map((item: { title: string; body: string }) => (
          <div class="card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="how-it-works">
    <div class="wrap">
      <span class="eyebrow">{t.howItWorks.eyebrow}</span>
      <h2>{t.howItWorks.title}</h2>
      <p>{t.howItWorks.body}</p>
      <ol class="step-list">
        {t.howItWorks.steps.map((s: string) => <li>{s}</li>)}
      </ol>
    </div>
  </section>

  <section class="section" id="photos">
    <div class="wrap">
      <div class="photo-grid">
        <figure class="photo-item photo-wide">
          <img src="/container-cascade/31020.jpg" alt="Full game setup, all role positions ready at the table" loading="lazy" />
          <figcaption>All roles at the table. Each player sees only their own numbers.</figcaption>
        </figure>
        <figure class="photo-item">
          <img src="/container-cascade/31022.jpg" alt="Havenmeester role card: move containers to the yard, signal the Vervoerder" loading="lazy" />
          <figcaption>The Havenmeester. A full yard means signalling the transporter.</figcaption>
        </figure>
        <figure class="photo-item">
          <img src="/container-cascade/31024.jpg" alt="Vervoerder role card: three transport modes, three different capacities" loading="lazy" />
          <figcaption>The Vervoerder. Truck, train, or barge. You choose.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="research">
    <div class="wrap">
      <span class="eyebrow">{t.research.eyebrow}</span>
      <h2>{t.research.title}</h2>
      <p>{t.research.body}</p>
    </div>
  </section>

  <section class="section section-dark">
    <div class="wrap" style="text-align:center; padding: 3rem 1.5rem;">
      <h2 style="color: var(--on-dark);">{t.cta.title}</h2>
      <p style="color: var(--on-dark-muted); max-width: 38rem; margin: 0 auto 2rem;">{t.cta.body}</p>
      <div class="hero-actions" style="justify-content: center;">
        <a class="btn btn-primary" href="/en/contact/">{t.cta.contact}</a>
        <a class="btn btn-ghost" href="https://container-collision.pages.dev/" target="_blank" rel="noopener">{t.cta.pdf}</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section-alt { background: var(--bg-alt); }
  .section-intro { max-width: 42rem; margin-bottom: 2rem; color: var(--ink-soft); }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.25rem; }
  .card { background: var(--surface); border: 1px solid var(--border); border-top: 4px solid var(--accent); border-radius: var(--radius-md); padding: 1.4rem 1.5rem; }
  .card h3 { font-size: 1.05rem; margin: 0 0 .5rem; }
  .card p { margin: 0; font-size: .95rem; color: var(--muted); }
  .step-list { max-width: 42rem; padding-left: 1.4rem; }
  .step-list li { margin-bottom: .75rem; }
  .hero-game-graphic { display: flex; align-items: center; justify-content: center; }
  .hero-photo { width: 340px; max-width: 100%; border-radius: var(--radius-md); box-shadow: 0 8px 32px rgba(0,0,0,.35); object-fit: cover; aspect-ratio: 3/4; }
  @media (max-width: 700px) { .hero-game-graphic { display: none; } }
  .photo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .photo-wide { grid-column: 1 / -1; }
  .photo-item { margin: 0; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border); }
  .photo-item img { width: 100%; height: 280px; object-fit: cover; display: block; }
  .photo-wide img { height: 360px; }
  .photo-item figcaption { padding: .6rem .8rem; font-size: .85rem; color: var(--ink-soft); background: var(--surface); }
  @media (max-width: 600px) { .photo-grid { grid-template-columns: 1fr; } .photo-wide { grid-column: 1; } }
</style>
