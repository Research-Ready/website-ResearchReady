---
import BaseLayout from '../../layouts/BaseLayout.astro';

const presentations = [
  {
    title: 'Quarto for the SOC',
    description: 'Automated reporting for Security Operations teams — SLTN',
    href: '/presentations/sltn-soc-quarto-presentation',
    lang: 'NL',
  },
  {
    title: 'Research-Ready: AI Pipelines',
    description: 'Overview presentation on reproducible research pipelines',
    href: '/presentations/example-presentation',
    lang: 'NL',
  },
];

const reports = [
  {
    title: 'Technical Security Report',
    description: 'Criminal prevention & digital resilience — SLTN',
    href: '/reports/sltn-criminal-prevention-report',
    lang: 'NL',
  },
  {
    title: 'Technical Architecture',
    description: 'BPMN process flows, component and sequence diagrams of the full Research-Ready pipeline',
    href: '/reports/rr-architecture',
    lang: 'NL',
  },
  {
    title: 'Pipeline Analysis Report',
    description: 'Example of an automatically generated analysis report',
    href: '/reports/example-report',
    lang: 'EN',
  },
];
---

<BaseLayout locale="en" title="Documents — Research-Ready" description="Automatically generated presentations and reports from Research-Ready.">
  <section class="section section-dark" style="padding-bottom: 2rem;">
    <div class="wrap">
      <span class="eyebrow">Automatic documentation</span>
      <h1>Documents</h1>
      <p class="lede">Presentations and reports generated by the Research-Ready Quarto pipeline — reproducible, current, and ready to share.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Presentations</h2>
      <div class="teaser-grid">
        {presentations.map((item) => (
          <a class="teaser-card doc-card" href={item.href} target="_blank" rel="noopener">
            <span class="teaser-index">{item.lang}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <span class="doc-link">Open →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2>Reports</h2>
      <div class="teaser-grid">
        {reports.map((item) => (
          <a class="teaser-card doc-card" href={item.href} target="_blank" rel="noopener">
            <span class="teaser-index">{item.lang}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <span class="doc-link">Open →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Certification & Training</h2>
      <div class="teaser-grid">
        <a class="teaser-card doc-card" href="/cert-prep/" target="_blank" rel="noopener">
          <span class="teaser-index">🎓</span>
          <h3>Cert Prep Hub</h3>
          <p>Study guides for Security+, CySA+, SC-900, SC-200, SC-300, CCNA and AZ-500 — with core concepts, practice questions and study strategies.</p>
          <span class="doc-link">Go to training site →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-dark cta-band">
    <div class="wrap">
      <h2>Want this for your organisation?</h2>
      <p class="lede">We build a pipeline that automatically turns your data into professional reports and presentations.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/en/contact/">Book a call</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .doc-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .doc-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }
  .doc-link {
    margin-top: auto;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
