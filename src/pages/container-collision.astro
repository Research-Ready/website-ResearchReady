---
import BaseLayout from '../layouts/BaseLayout.astro';
import { nl } from '../i18n/nl';

const t = nl.containerCollision;
---

<BaseLayout locale="nl" title={t.title} description={t.description}>

  <!-- Hero -->
  <section class="hero section-dark">
    <div class="wrap">
      <div class="hero-copy">
        <span class="eyebrow">{t.eyebrow}</span>
        <h1>{t.headline}</h1>
        <p class="lede">{t.lede}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#leeruitkomsten">{t.ctaLearn}</a>
          <a class="btn btn-ghost" href="/contact/">{t.ctaContact}</a>
        </div>
      </div>
      <div class="hero-game-graphic">
        <img src="/container-cascade/31026.jpg" alt="Container Cascade in spel: spelers bewegen containers over het bord, oranje puntenfiches zichtbaar" class="hero-photo" />
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="section" id="voor-wie">
    <div class="wrap split">
      <div class="split-copy">
        <span class="eyebrow">{t.audience.eyebrow}</span>
        <h2>{t.audience.title}</h2>
        <p>{t.audience.body}</p>
      </div>
      <ul class="check-list">
        {t.audience.points.map((p: string) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <!-- Learning outcomes -->
  <section class="section section-alt" id="leeruitkomsten">
    <div class="wrap">
      <span class="eyebrow">{t.outcomes.eyebrow}</span>
      <h2>{t.outcomes.title}</h2>
      <p class="section-intro">{t.outcomes.intro}</p>
      <div class="card-grid">
        {t.outcomes.items.map((item: { title: string; body: string }) => (
          <div class="card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section" id="spelverloop">
    <div class="wrap">
      <span class="eyebrow">{t.howItWorks.eyebrow}</span>
      <h2>{t.howItWorks.title}</h2>
      <p>{t.howItWorks.body}</p>
      <ol class="step-list">
        {t.howItWorks.steps.map((s: string) => <li>{s}</li>)}
      </ol>
    </div>
  </section>

  <!-- Photo gallery -->
  <section class="section" id="fotos">
    <div class="wrap">
      <div class="photo-grid">
        <figure class="photo-item photo-wide">
          <img src="/container-cascade/31020.jpg" alt="Spelopstelling: alle rollen klaar aan tafel, rol-kaarten zichtbaar" loading="lazy" />
          <figcaption>Alle rollen aan tafel. Elke speler ziet alleen zijn eigen cijfers.</figcaption>
        </figure>
        <figure class="photo-item">
          <img src="/container-cascade/31022.jpg" alt="Havenmeester rolkaart: containers naar de yard verplaatsen en de Vervoerder seinen" loading="lazy" />
          <figcaption>De Havenmeester. Een volle yard geef je door aan de Vervoerder.</figcaption>
        </figure>
        <figure class="photo-item">
          <img src="/container-cascade/31024.jpg" alt="Vervoerder rolkaart: drie vervoersmiddelen, drie capaciteiten" loading="lazy" />
          <figcaption>De Vervoerder. Vrachtwagen, trein of binnenvaart, jij kiest.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Research / evidence base -->
  <section class="section section-alt" id="onderzoek">
    <div class="wrap">
      <span class="eyebrow">{t.research.eyebrow}</span>
      <h2>{t.research.title}</h2>
      <p>{t.research.body}</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark">
    <div class="wrap" style="text-align:center; padding: 3rem 1.5rem;">
      <h2 style="color: var(--on-dark);">{t.cta.title}</h2>
      <p style="color: var(--on-dark-muted); max-width: 38rem; margin: 0 auto 2rem;">{t.cta.body}</p>
      <div class="hero-actions" style="justify-content: center;">
        <a class="btn btn-primary" href="/contact/">{t.cta.contact}</a>
        <a class="btn btn-ghost" href="https://container-collision.pages.dev/index.pdf" target="_blank" rel="noopener">{t.cta.pdf}</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section-alt {
    background: var(--bg-alt);
  }
  .section-intro {
    max-width: 42rem;
    margin-bottom: 2rem;
    color: var(--ink-soft);
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 4px solid var(--accent);
    border-radius: var(--radius-md);
    padding: 1.4rem 1.5rem;
  }
  .card h3 {
    font-size: 1.05rem;
    margin: 0 0 .5rem;
  }
  .card p {
    margin: 0;
    font-size: .95rem;
    color: var(--muted);
  }
  .step-list {
    max-width: 42rem;
    padding-left: 1.4rem;
  }
  .step-list li {
    margin-bottom: .75rem;
  }
  .hero-game-graphic {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-photo {
    width: 340px;
    max-width: 100%;
    border-radius: var(--radius-md);
    box-shadow: 0 8px 32px rgba(0,0,0,.35);
    object-fit: cover;
    aspect-ratio: 3/4;
  }
  @media (max-width: 700px) {
    .hero-game-graphic { display: none; }
  }
  .photo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 1rem;
  }
  .photo-wide {
    grid-column: 1 / -1;
  }
  .photo-item {
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .photo-item img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    display: block;
  }
  .photo-wide img {
    height: 360px;
  }
  .photo-item figcaption {
    padding: .6rem .8rem;
    font-size: .85rem;
    color: var(--ink-soft);
    background: var(--surface);
  }
  @media (max-width: 600px) {
    .photo-grid { grid-template-columns: 1fr; }
    .photo-wide { grid-column: 1; }
  }
</style>
