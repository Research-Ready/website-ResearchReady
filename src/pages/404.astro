---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout locale="nl" title="Pagina niet gevonden" description="Deze pagina bestaat niet.">
  <section class="section" style="text-align: center;">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>Pagina niet gevonden</h1>
      <p class="lede" style="margin: 1rem auto 0;">
        Deze pagina bestaat niet, of is verplaatst.<br />
        This page doesn't exist, or has moved.
      </p>
      <div class="hero-actions" style="justify-content: center;">
        <a class="btn btn-primary" href="/">Terug naar home</a>
        <a class="btn btn-ghost" href="/en/">English site</a>
      </div>
    </div>
  </section>
</BaseLayout>
