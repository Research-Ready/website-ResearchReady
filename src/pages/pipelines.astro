---
import BaseLayout from '../layouts/BaseLayout.astro';
import PipelineCatalog from '../components/PipelineCatalog.astro';
import { nl } from '../i18n/nl';

const t = nl;
---

<BaseLayout locale="nl" title={t.pipelines.title} description={t.pipelines.intro}>
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Catalogus & Portfolio</span>
      <h1>{t.pipelines.title}</h1>
      <p class="lede">{t.pipelines.intro}</p>
      <PipelineCatalog locale="nl" />
    </div>
  </section>
</BaseLayout>
